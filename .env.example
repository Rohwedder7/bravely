PORT=3333
# Supabase (recomendado no Docker): use a Connection string do pooler (Transaction), uma única linha.
# Project Settings → Database → Connection string → URI → modo "Transaction" → porta 6543.
# Ex.: postgresql://postgres.PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Postgres local no Docker: use host.docker.internal no lugar de localhost.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
CLOUDFLARE_PUBLIC_URL=""

VITE_FRONTEND_URL=
VITE_BACKEND_URL=
