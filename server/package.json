    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fast-csv": "^5.0.5",
    "fastify": "^5.7.4",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
